<UserControl
    x:Class="Charm.Renderer.RendererViewport"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Charm.Renderer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="1080"
    d:DesignWidth="1920"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">
    <UserControl.Resources>
        <local:ChannelHashToString x:Key="ChannelHashToString" />
    </UserControl.Resources>

    <Grid Background="Black">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock
            x:Name="OverrideWarning"
            Grid.Column="1"
            Margin="0,10,60,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Panel.ZIndex="100"
            Foreground="Red"
            IsHitTestVisible="False"
            Text="⚠ Mesh contains a skeleton, using Override Vertex Shader.&#x0a;Final result may be inaccurate!"
            TextAlignment="Center"
            Visibility="Hidden" />

        <StackPanel
            x:Name="InfoPanel"
            Grid.Column="0"
            Margin="20,20,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Panel.ZIndex="100"
            Orientation="Vertical">

            <StackPanel Orientation="Horizontal">
                <ToggleButton
                    x:Name="AtmosButton"
                    Margin="0,2,0,2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Click="AtmosButton_Click"
                    IsChecked="True"
                    Style="{DynamicResource D2StyleToggleBoxButton}">
                    <ToggleButton.LayoutTransform>
                        <ScaleTransform ScaleX=".75" ScaleY=".75" />
                    </ToggleButton.LayoutTransform>
                </ToggleButton>

                <TextBlock
                    Margin="0"
                    VerticalAlignment="Center"
                    FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                    FontSize="14"
                    Text="Render Sky"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Grid Background="#A9000000">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=AtmosButton}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <StackPanel Margin="5,0,5,0" Orientation="Vertical">
                    <StackPanel Margin="5" Orientation="Horizontal">
                        <TextBlock
                            Margin="0"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                            FontSize="14"
                            Text="Time Of Day"
                            TextWrapping="Wrap" />

                        <Slider
                            Name="TimeOfDaySlider"
                            Width="200"
                            Height="10"
                            Margin="10,0,0,0"
                            HorizontalAlignment="Center"
                            Maximum="1"
                            Minimum="0"
                            ValueChanged="TimeOfDaySlider_ValueChanged"
                            Value="0.675" />
                    </StackPanel>


                    <StackPanel
                        Margin="5"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                        <TextBlock
                            Margin="0"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                            FontSize="14"
                            Text="Sky Rotation"
                            TextWrapping="Wrap" />

                        <Slider
                            Name="AtmosRotationSlider"
                            Width="200"
                            Height="10"
                            Margin="10,0,0,0"
                            HorizontalAlignment="Center"
                            Maximum="1"
                            Minimum="0"
                            ValueChanged="AtmosRotationSlider_ValueChanged"
                            Value="0" />
                    </StackPanel>

                    <StackPanel
                        Margin="5"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                        <TextBlock
                            Margin="0"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                            FontSize="14"
                            Text="Sky Intensity"
                            TextWrapping="Wrap" />

                        <Slider
                            Name="AtmosIntensitySlider"
                            Width="200"
                            Height="10"
                            Margin="10,0,0,0"
                            HorizontalAlignment="Center"
                            Maximum="1"
                            Minimum="0"
                            ValueChanged="AtmosIntensitySlider_ValueChanged"
                            Value="0.75" />
                    </StackPanel>
                </StackPanel>
            </Grid>



            <StackPanel Orientation="Horizontal">
                <ToggleButton
                    x:Name="ShowGridButton"
                    Margin="0,2,0,2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Click="ShowGridButton_Checked"
                    IsChecked="True"
                    Style="{DynamicResource D2StyleToggleBoxButton}">
                    <ToggleButton.LayoutTransform>
                        <ScaleTransform ScaleX=".75" ScaleY=".75" />
                    </ToggleButton.LayoutTransform>
                </ToggleButton>
                <TextBlock
                    Margin="0"
                    VerticalAlignment="Center"
                    FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                    FontSize="14"
                    Text="Show Grid"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <ToggleButton
                    Name="DebugButton"
                    Margin="0,2,0,2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    d:IsChecked="True"
                    Style="{DynamicResource D2StyleToggleBoxButton}">
                    <ToggleButton.LayoutTransform>
                        <ScaleTransform ScaleX=".75" ScaleY=".75" />
                    </ToggleButton.LayoutTransform>
                </ToggleButton>

                <TextBlock
                    Margin="0"
                    VerticalAlignment="Center"
                    FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                    FontSize="14"
                    Text="Debug"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel
                Name="DebugText"
                Background="#A9000000"
                Visibility="{Binding IsChecked, ElementName=DebugButton, Converter={StaticResource BooleanToVisibilityConverter}}">

                <StackPanel Margin="5" Orientation="Horizontal">
                    <TextBlock
                        Margin="0"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                        FontSize="14"
                        Text="Exposure"
                        TextWrapping="Wrap" />

                    <Slider
                        Name="ExposureSlider"
                        Width="200"
                        Height="10"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Center"
                        Maximum="2"
                        Minimum="0"
                        ValueChanged="ExposureSlider_ValueChanged"
                        Value="0.8" />
                </StackPanel>

                <StackPanel Margin="5" Orientation="Vertical">
                    <TextBlock
                        x:Name="CameraPosition"
                        FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                        FontSize="14"
                        Foreground="Cyan" />

                    <TextBlock
                        x:Name="CameraRotation"
                        FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                        FontSize="14"
                        Foreground="Cyan" />

                    <TextBlock
                        x:Name="FrameTime"
                        FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                        FontSize="14"
                        Foreground="Cyan" />
                </StackPanel>

                <Button
                    Margin="5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Panel.ZIndex="1"
                    Click="InvestmentDyeTest_Click"
                    Focusable="False"
                    Style="{StaticResource D2StyleButton}">

                    <TextBlock
                        Margin="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="Investment Dye Test" />
                </Button>

                <Button
                    Margin="5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Panel.ZIndex="1"
                    Click="PrintGlobalChannels_Click"
                    Focusable="False"
                    Style="{StaticResource D2StyleButton}">

                    <TextBlock
                        Margin="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="Print Global Channels" />
                </Button>

            </StackPanel>

            <Grid
                Margin="0,5,0,5"
                HorizontalAlignment="Left"
                Background="#A9000000">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10*" />
                    <ColumnDefinition Width="50*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Margin="20,0,20,0"
                    VerticalAlignment="Center"
                    FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                    FontSize="14"
                    Text="Render Pass"
                    TextWrapping="Wrap" />

                <ComboBox
                    x:Name="Combobox"
                    Grid.Column="1"
                    Width="150"
                    Margin="5"
                    BorderBrush="Transparent"
                    BorderThickness="1"
                    Focusable="False"
                    IsReadOnly="False"
                    SelectionChanged="Dropdown_OnSelectionChanged"
                    Style="{DynamicResource D2StyleComboBox}" />
            </Grid>

            <Expander
                x:Name="ObjectChannelsExpander"
                Margin="0,5,0,5"
                HorizontalAlignment="Left"
                Background="#A9000000"
                Visibility="Collapsed">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Text="Object Channels" />

                        <Button
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Panel.ZIndex="1"
                            Click="ResetObjectChannels_Click"
                            Focusable="False"
                            Style="{StaticResource D2StyleButtonNoOverlay}"
                            Visibility="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock
                                Margin="0"
                                VerticalAlignment="Top"
                                FontSize="18"
                                Foreground="White"
                                Text="⟳" />

                        </Button>
                    </StackPanel>

                </Expander.Header>

                <ItemsControl x:Name="ObjectChannelsEditor" Margin="20,0,20,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <UniformGrid
                                Margin="0,2,0,2"
                                Columns="2"
                                Rows="1">

                                <TextBlock
                                    Margin="0,0,10,0"
                                    Foreground="White"
                                    Text="{Binding Key, Converter={StaticResource ChannelHashToString}}" />
                                <local:Vector4Editor DataContext="{Binding Value}" />
                            </UniformGrid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>


            <Expander
                x:Name="MaterialPermutationsExpander"
                Margin="0,5,0,5"
                HorizontalAlignment="Left"
                Background="#A9000000"
                Visibility="Collapsed">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Text="Material Permutations" />
                    </StackPanel>
                </Expander.Header>

                <StackPanel HorizontalAlignment="Left" Orientation="Vertical">

                    <TextBlock
                        x:Name="PermIndexDebug"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                        FontSize="11"
                        TextWrapping="Wrap" />

                    <StackPanel
                        x:Name="MaterialVariantPanel"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />

                </StackPanel>
            </Expander>

        </StackPanel>

        <Grid
            x:Name="ViewportContainer"
            Grid.ColumnSpan="2"
            Panel.ZIndex="-1">

            <Button
                Width="40"
                Height="40"
                Margin="5"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Panel.ZIndex="1"
                Click="Fullscreen_Click"
                Focusable="False"
                Style="{StaticResource D2StyleButton}">

                <TextBlock
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="25"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="⛶" />

            </Button>

            <Image
                x:Name="RT0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="1" />

            <TextBlock
                x:Name="FPSCounter"
                Grid.Column="1"
                Margin="3"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Focusable="False"
                FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                FontSize="14"
                Opacity="0.5"
                TextOptions.TextFormattingMode="Display" />
        </Grid>

    </Grid>
</UserControl>
