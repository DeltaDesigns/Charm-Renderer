<UserControl
    x:Class="Charm.Renderer.RendererViewport"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:charm="clr-namespace:Charm;assembly=Charm"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Charm.Renderer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="clr-namespace:Charm.Shared;assembly=Charm.Shared"
    d:DesignHeight="1080"
    d:DesignWidth="1920"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:ChannelHashToString x:Key="ChannelHashToString" />
        <DataTemplate DataType="{x:Type local:VectorSetting}">
            <StackPanel Margin="2" Orientation="Horizontal">
                <TextBlock
                    Width="100"
                    Margin="0"
                    VerticalAlignment="Center"
                    FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                    FontSize="14"
                    Text="{Binding Text}" />
                <local:Vector4Editor HorizontalAlignment="Left" DataContext="{Binding Value}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:ToggleSetting}">
            <StackPanel Margin="4" Orientation="Horizontal">
                <ToggleButton IsChecked="{Binding IsChecked, Mode=TwoWay}" Style="{DynamicResource D2StyleToggleBoxButton}">
                    <ToggleButton.LayoutTransform>
                        <ScaleTransform ScaleX=".75" ScaleY=".75" />
                    </ToggleButton.LayoutTransform>
                </ToggleButton>

                <TextBlock
                    Margin="0"
                    VerticalAlignment="Center"
                    FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                    FontSize="14"
                    Text="{Binding Text}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:SliderSetting}">
            <StackPanel Margin="4" Orientation="Horizontal">

                <ToggleButton
                    Margin="0,0,5,0"
                    VerticalAlignment="Center"
                    IsChecked="{Binding IsLocked}"
                    ToolTip="{Binding LockTooltip}"
                    Visibility="{Binding IsLockable, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <ToggleButton.Style>
                        <Style BasedOn="{StaticResource D2StyleTagListButton}" TargetType="ToggleButton">
                            <Setter Property="Content" Value="🔓" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="FontFamily" Value="Segoe UI Symbol" />

                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Content" Value="🔒" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>

                <TextBlock
                    MinWidth="100"
                    VerticalAlignment="Center"
                    FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                    FontSize="14"
                    Text="{Binding Text}" />

                <Slider
                    Width="200"
                    Margin="0,0,5,0"
                    VerticalAlignment="Center"
                    Maximum="{Binding Max}"
                    Minimum="{Binding Min}"
                    Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <Slider.LayoutTransform>
                        <ScaleTransform ScaleX="1" ScaleY=".75" />
                    </Slider.LayoutTransform>
                </Slider>

                <TextBox
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    FontSize="14"
                    Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" />
            </StackPanel>
        </DataTemplate>

        <!--  Consumable  -->
        <DataTemplate x:Key="ConsumableEntry">
            <Grid Margin="0,0,0,0" Background="Transparent">
                <Grid Focusable="False" IsHitTestVisible="False">
                    <Border
                        Width="12"
                        Height="12"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="1,0,0,1"
                        Focusable="False" />

                    <Border
                        Width="12"
                        Height="12"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="1,1,0,0"
                        Focusable="False" />

                    <Border
                        Width="12"
                        Height="12"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="0,0,1,1"
                        Focusable="False" />

                    <Border
                        Width="12"
                        Height="12"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="0,1,1,0"
                        Focusable="False" />
                </Grid>
                <Grid Visibility="{Binding IsPlaceholder, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <Image
                        Width="96"
                        Height="96"
                        Margin="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        RenderOptions.BitmapScalingMode="NearestNeighbor"
                        Source="{Binding IconBackground}" />

                    <Image
                        Width="96"
                        Height="96"
                        Margin="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        RenderOptions.BitmapScalingMode="NearestNeighbor"
                        Source="{Binding Icon}" />

                    <Image
                        Width="96"
                        Height="96"
                        Margin="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        RenderOptions.BitmapScalingMode="NearestNeighbor"
                        Source="{Binding IconOverlay}" />

                    <RadioButton
                        Width="96"
                        Height="96"
                        charm:StyleHelper.BorderThickness="0.75"
                        Checked="PlugItem_Checked"
                        Focusable="False"
                        GroupName="{Binding Index}"
                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        IsHitTestVisible="True"
                        Style="{StaticResource D2StyleRadioButtonNoSelectedOverlay}" />

                    <Border
                        BorderThickness="3"
                        Focusable="False"
                        Style="{StaticResource GreyBorderWhiteOnHover}">
                        <Grid
                            Width="22"
                            Height="48"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False"
                            Visibility="{Binding ItemWatermark, Converter={StaticResource NullToVisibilityConverter}}">
                            <Rectangle
                                Grid.Row="1"
                                Width="22"
                                Height="48"
                                Opacity="0.6"
                                Stretch="Fill">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                        <GradientStop Offset="0" Color="#00000000" />
                                        <GradientStop Offset="1" Color="Black" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Image
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Source="{Binding ItemWatermark}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ConsumableSocket">
            <Grid MaxHeight="96" Margin="0,0,0,10">
                <charm:HoverPopupWrapper EnableMotionEffect="False" PopupParent="{x:Type charm:SocketCategory}">
                    <charm:HoverPopupWrapper.Target>
                        <Grid Grid.Row="0" Margin="0,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Content="{Binding SelectedPlug}" ContentTemplate="{StaticResource ConsumableEntry}" />

                                <TextBlock
                                    Margin="10,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Panel.ZIndex="1"
                                    FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                                    FontSize="18"
                                    Foreground="{StaticResource ForegroundColour100}"
                                    Text="{Binding SelectedPlug.Item.Name}" />
                            </StackPanel>

                        </Grid>
                    </charm:HoverPopupWrapper.Target>

                    <charm:HoverPopupWrapper.PopupContent>
                        <Grid Margin="0,5,0,0">
                            <Grid.Effect>
                                <DropShadowEffect
                                    BlurRadius="10"
                                    Direction="0"
                                    ShadowDepth="0"
                                    Color="#905C5C5C" />
                            </Grid.Effect>

                            <charm:ItemPage
                                Margin="-40,0,0,0"
                                CollapsePageButtons="False"
                                Columns="7"
                                ItemMargin="4"
                                ItemTemplate="{StaticResource ConsumableEntry}"
                                Items="{Binding PlugItems}"
                                ItemsPerPage="21"
                                PageBackgroundColor="#53616164"
                                SelectOnPageChange="False"
                                SlideDistance="10"
                                TransitionSpeed="0.125"
                                UsePlaceholders="True" />
                        </Grid>

                    </charm:HoverPopupWrapper.PopupContent>
                </charm:HoverPopupWrapper>
            </Grid>
        </DataTemplate>
        <!--  End Consumbable  -->

        <!--  Socket Category  -->
        <DataTemplate x:Key="SocketCategory">
            <Grid Margin="0,0,0,0" HorizontalAlignment="Left">
                <Grid VerticalAlignment="Top">
                    <ItemsControl ItemTemplate="{StaticResource ConsumableSocket}" ItemsSource="{Binding Sockets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel
                                    Grid.Row="0"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </Grid>
        </DataTemplate>
        <!--  End Socket Category  -->

    </UserControl.Resources>

    <Grid Background="Black">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock
            x:Name="OverrideWarning"
            Grid.Column="1"
            Margin="0,10,60,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Panel.ZIndex="100"
            Foreground="Red"
            IsHitTestVisible="False"
            Text="⚠ Mesh contains a skeleton, using Override Vertex Shader.&#x0a;Final result may be inaccurate!"
            TextAlignment="Center"
            Visibility="Hidden" />

        <Canvas x:Name="InfoPanel" Grid.ColumnSpan="2">
            <StackPanel
                shared:Draggable.ClampToParent="True"
                shared:Draggable.Handle="{Binding ElementName=InfoPanelDragHeader}"
                shared:Draggable.InitialLeft="10"
                shared:Draggable.InitialTop="25"
                shared:Draggable.IsEnabled="True"
                Background="#75000000">
                <Border
                    x:Name="InfoPanelDragHeader"
                    BorderBrush="#75000000"
                    BorderThickness="5" />

                <Expander HorizontalAlignment="Stretch" Background="Transparent">
                    <Expander.Header>
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Text="Controls" />
                    </Expander.Header>

                    <Border BorderBrush="#759D9D9D" BorderThickness="0,1,0,0">
                        <StackPanel
                            Margin="5"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            Orientation="Vertical">

                            <ContentControl x:Name="ShowGridButton" />
                            <ContentControl x:Name="ShowAtmosSettings" />

                            <Border
                                Background="#75000000"
                                BorderBrush="#759D9D9D"
                                BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Content.IsChecked, ElementName=ShowAtmosSettings}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel>
                                    <ItemsControl x:Name="AtmosOptions">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Margin="5" Orientation="Vertical" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>

                                    <Grid
                                        Margin="5"
                                        HorizontalAlignment="Stretch"
                                        Background="#75000000">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="10*" />
                                            <ColumnDefinition Width="50*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                                            FontSize="14"
                                            Text="Scene World"
                                            TextWrapping="Wrap" />

                                        <ComboBox
                                            x:Name="SceneWorldCombobox"
                                            Grid.Column="1"
                                            Margin="5"
                                            BorderBrush="Transparent"
                                            BorderThickness="1"
                                            Focusable="False"
                                            IsReadOnly="False"
                                            SelectionChanged="SceneWorld_OnSelectionChanged"
                                            Style="{DynamicResource D2StyleComboBox}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Grid
                                Margin="0,5,0,5"
                                HorizontalAlignment="Stretch"
                                Background="#75000000">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="10*" />
                                    <ColumnDefinition Width="50*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                                    FontSize="14"
                                    Text="Render Pass"
                                    TextWrapping="Wrap" />

                                <ComboBox
                                    x:Name="RenderPassCombobox"
                                    Grid.Column="1"
                                    Margin="5"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    Focusable="False"
                                    IsReadOnly="False"
                                    SelectionChanged="Dropdown_OnSelectionChanged"
                                    Style="{DynamicResource D2StyleComboBox}" />
                            </Grid>

                            <!--  Debug Options  -->
                            <Expander
                                Margin="0,0,0,0"
                                HorizontalAlignment="Stretch"
                                Background="#75000000"
                                KeyboardNavigation.DirectionalNavigation="None">
                                <Expander.Header>
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        Text="Debug Options" />
                                </Expander.Header>

                                <Border BorderBrush="#759D9D9D" BorderThickness="0,1,0,0">
                                    <StackPanel>
                                        <ItemsControl x:Name="DebugOptions">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Margin="5" Orientation="Vertical" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>

                                        <StackPanel Margin="5" Orientation="Vertical">
                                            <TextBlock
                                                x:Name="CameraPosition"
                                                FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                                                FontSize="14"
                                                Foreground="Cyan" />

                                            <TextBlock
                                                x:Name="CameraRotation"
                                                FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                                                FontSize="14"
                                                Foreground="Cyan" />

                                            <TextBlock
                                                x:Name="FrameTime"
                                                FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                                                FontSize="14"
                                                Foreground="Cyan" />
                                        </StackPanel>

                                        <Button
                                            Margin="5"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Bottom"
                                            Panel.ZIndex="1"
                                            Click="PrintGlobalChannels_Click"
                                            Focusable="False"
                                            Style="{StaticResource D2StyleButton}">

                                            <TextBlock
                                                Margin="2"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                Text="Print Global Channels" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Expander>

                        </StackPanel>
                    </Border>
                </Expander>
            </StackPanel>
        </Canvas>

        <Canvas x:Name="ObjectPanel" Grid.ColumnSpan="2">
            <StackPanel
                shared:Draggable.ClampToParent="True"
                shared:Draggable.Handle="{Binding ElementName=ObjectPanelDragHeader}"
                shared:Draggable.InitialLeft="175"
                shared:Draggable.InitialTop="25"
                shared:Draggable.IsEnabled="True"
                Background="#75000000">
                <Border
                    x:Name="ObjectPanelDragHeader"
                    BorderBrush="#75000000"
                    BorderThickness="5" />

                <Expander
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    KeyboardNavigation.DirectionalNavigation="None">
                    <Expander.Header>
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Text="Object" />
                    </Expander.Header>

                    <Border BorderBrush="#759D9D9D" BorderThickness="0,1,0,0">
                        <StackPanel Margin="5">
                            <ItemsControl x:Name="ObjectTransforms">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Margin="5" Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <ItemsControl x:Name="ObjectOptions">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Margin="5" Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <Expander
                                x:Name="MeshGroupsExpander"
                                MaxHeight="500"
                                Margin="0,5,0,5"
                                HorizontalAlignment="Stretch"
                                Background="#75000000"
                                Visibility="Collapsed">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Foreground="White"
                                            Text="Mesh Groups" />

                                        <Button
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Panel.ZIndex="1"
                                            Click="ResetMeshGroups_Click"
                                            Focusable="False"
                                            Style="{StaticResource D2StyleButtonNoOverlay}"
                                            Visibility="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock
                                                Margin="0"
                                                VerticalAlignment="Top"
                                                FontSize="18"
                                                Foreground="White"
                                                Text="⟳" />
                                        </Button>
                                    </StackPanel>
                                </Expander.Header>

                                <ScrollViewer
                                    Margin="0,0,0,0"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <ScrollViewer.Resources>
                                        <Style BasedOn="{StaticResource VerticalScrollBarStyle}" TargetType="ScrollBar">
                                            <Setter Property="Width" Value="7" />
                                        </Style>
                                    </ScrollViewer.Resources>

                                    <ItemsControl x:Name="MeshGroups" Margin="20,0,20,10">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:ToggleSetting}">
                                                <StackPanel Margin="3" Orientation="Horizontal">
                                                    <ToggleButton
                                                        IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                        PreviewMouseLeftButtonDown="MeshGroup_PreviewMouseLeftButtonDown"
                                                        Style="{DynamicResource D2StyleToggleBoxButton}">
                                                        <ToggleButton.LayoutTransform>
                                                            <ScaleTransform ScaleX=".75" ScaleY=".75" />
                                                        </ToggleButton.LayoutTransform>
                                                    </ToggleButton>

                                                    <TextBlock
                                                        Margin="0"
                                                        VerticalAlignment="Center"
                                                        FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                                                        FontSize="14"
                                                        Text="{Binding Text}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Expander>

                            <Expander
                                x:Name="ObjectChannelsExpander"
                                MaxHeight="500"
                                Margin="0,5,0,5"
                                HorizontalAlignment="Stretch"
                                Background="#75000000"
                                Visibility="Collapsed">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Foreground="White"
                                            Text="Object Channels" />

                                        <Button
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Panel.ZIndex="1"
                                            Click="ResetObjectChannels_Click"
                                            Focusable="False"
                                            Style="{StaticResource D2StyleButtonNoOverlay}"
                                            Visibility="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock
                                                Margin="0"
                                                VerticalAlignment="Top"
                                                FontSize="18"
                                                Foreground="White"
                                                Text="⟳" />
                                        </Button>
                                    </StackPanel>
                                </Expander.Header>

                                <ScrollViewer
                                    Margin="0,0,0,0"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <ScrollViewer.Resources>
                                        <Style BasedOn="{StaticResource VerticalScrollBarStyle}" TargetType="ScrollBar">
                                            <Setter Property="Width" Value="7" />
                                        </Style>
                                    </ScrollViewer.Resources>
                                    <ItemsControl x:Name="ObjectChannelsEditor" Margin="20,0,20,10">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <UniformGrid
                                                    Margin="0,2,0,2"
                                                    Columns="2"
                                                    Rows="1">
                                                    <TextBlock
                                                        Margin="0,0,10,0"
                                                        Foreground="White"
                                                        Text="{Binding Key, Converter={StaticResource ChannelHashToString}}" />
                                                    <local:Vector4Editor DataContext="{Binding Value}" />
                                                </UniformGrid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Expander>

                            <Expander
                                x:Name="MaterialPermutationsExpander"
                                Margin="0,5,0,5"
                                HorizontalAlignment="Stretch"
                                Background="#75000000"
                                KeyboardNavigation.DirectionalNavigation="None"
                                Visibility="Collapsed">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Foreground="White"
                                            Text="Material Permutations" />
                                    </StackPanel>
                                </Expander.Header>

                                <StackPanel HorizontalAlignment="Stretch" Orientation="Vertical">
                                    <TextBlock
                                        x:Name="PermIndexDebug"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                                        FontSize="11"
                                        TextWrapping="Wrap" />

                                    <ContentControl x:Name="PermIndexOverride" />

                                    <StackPanel
                                        x:Name="MaterialVariantPanel"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch" />

                                </StackPanel>
                            </Expander>


                            <Expander
                                x:Name="ItemShadersExpander"
                                Margin="0,5,0,5"
                                HorizontalAlignment="Stretch"
                                Background="#75000000"
                                Visibility="Collapsed">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Foreground="White"
                                            Text="Item Shaders" />

                                        <StackPanel
                                            Margin="15,0,0,0"
                                            Orientation="Vertical"
                                            Visibility="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <RadioButton
                                                Margin="2"
                                                Click="InvesmentShadersOrderBy_Click"
                                                Content="Name"
                                                GroupName="InvestmentShaderSortBy"
                                                IsChecked="False"
                                                Tag="0" />
                                            <RadioButton
                                                Margin="2"
                                                Click="InvesmentShadersOrderBy_Click"
                                                Content="Index"
                                                GroupName="InvestmentShaderSortBy"
                                                IsChecked="True"
                                                Tag="1" />
                                        </StackPanel>
                                    </StackPanel>
                                </Expander.Header>

                                <ContentControl
                                    x:Name="ItemShaders"
                                    Margin="10,0,0,0"
                                    ContentTemplate="{StaticResource SocketCategory}" />
                            </Expander>

                        </StackPanel>
                    </Border>

                </Expander>
            </StackPanel>


        </Canvas>

        <Grid
            x:Name="ViewportContainer"
            Grid.ColumnSpan="2"
            Panel.ZIndex="-1">

            <Button
                Width="40"
                Height="40"
                Margin="5"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Panel.ZIndex="1"
                Click="Fullscreen_Click"
                Focusable="False"
                Style="{StaticResource D2StyleButton}">

                <TextBlock
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="25"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="⛶" />

            </Button>

            <Image
                x:Name="RT0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="1" />

            <TextBlock
                x:Name="FPSCounter"
                Grid.Column="1"
                Margin="15,5,5,5"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#78000000"
                Focusable="False"
                FontFamily="Arial"
                FontSize="14"
                Foreground="White"
                Opacity="0.75"
                TextOptions.TextFormattingMode="Display" />
        </Grid>

    </Grid>
</UserControl>
