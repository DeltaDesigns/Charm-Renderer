<UserControl
    x:Class="Charm.Renderer.RendererViewport"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:charm="clr-namespace:Charm;assembly=Charm"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Charm.Renderer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="clr-namespace:Charm.Shared;assembly=Charm.Shared"
    d:DesignHeight="1080"
    d:DesignWidth="1920"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:ChannelHashToString x:Key="ChannelHashToString" />
        <DataTemplate DataType="{x:Type local:SeparatorItem}">
            <StackPanel
                x:Name="Root"
                Margin="4,10,4,0"
                Orientation="Vertical">

                <TextBlock
                    Width="100"
                    Margin="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                    FontSize="14"
                    Text="{Binding Text}" />
                <Border
                    Height="1"
                    Margin="0,4,0,4"
                    Background="{DynamicResource ForegroundColour50}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:VectorSetting}">
            <StackPanel
                x:Name="Root"
                Margin="4"
                Orientation="Horizontal">
                <TextBlock
                    Width="100"
                    Margin="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                    FontSize="14"
                    Text="{Binding Text}" />
                <local:Vector4Editor
                    HorizontalAlignment="Left"
                    DataContext="{Binding Value}"
                    DragSpeed="{Binding DataContext.DragSpeed, ElementName=Root}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:ToggleSetting}">
            <StackPanel Margin="4" Orientation="Horizontal">
                <ToggleButton IsChecked="{Binding IsChecked, Mode=TwoWay}" Style="{DynamicResource D2StyleToggleBoxButton}">
                    <ToggleButton.LayoutTransform>
                        <ScaleTransform ScaleX=".75" ScaleY=".75" />
                    </ToggleButton.LayoutTransform>
                </ToggleButton>

                <TextBlock
                    Margin="0"
                    VerticalAlignment="Center"
                    FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                    FontSize="14"
                    Text="{Binding Text}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:SliderSetting}">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="25*" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="175" />
                    <ColumnDefinition Width="25*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Width="125"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                    FontSize="14"
                    Text="{Binding Text}"
                    TextWrapping="WrapWithOverflow" />

                <ToggleButton
                    Grid.Column="1"
                    Width="20"
                    Height="20"
                    Margin="0,0,10,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsChecked="{Binding IsLocked}"
                    ToolTip="{Binding LockTooltip}"
                    Visibility="{Binding IsLockable, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <ToggleButton.Content>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI Symbol"
                            FontSize="18"
                            Foreground="White">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="🔓" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                            <Setter Property="Text" Value="🔒" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </ToggleButton.Content>

                    <ToggleButton.Style>
                        <Style BasedOn="{StaticResource D2StyleTagListButton}" TargetType="ToggleButton" />
                    </ToggleButton.Style>
                </ToggleButton>

                <Slider
                    Grid.Column="2"
                    Width="175"
                    Margin="0,0,0,0"
                    VerticalAlignment="Center"
                    Maximum="{Binding Max}"
                    Minimum="{Binding Min}"
                    Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <Slider.LayoutTransform>
                        <ScaleTransform ScaleX="1" ScaleY=".75" />
                    </Slider.LayoutTransform>
                </Slider>

                <TextBox
                    Grid.Column="3"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Right"
                    VerticalContentAlignment="Center"
                    FontSize="14"
                    Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" />
            </Grid>
        </DataTemplate>

        <!--  Consumable  -->
        <DataTemplate x:Key="ConsumableEntry">
            <Grid Margin="0,0,0,0" Background="Transparent">
                <Grid Focusable="False" IsHitTestVisible="False">
                    <Border
                        Width="10"
                        Height="10"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="1,0,0,1"
                        Focusable="False" />

                    <Border
                        Width="10"
                        Height="10"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="1,1,0,0"
                        Focusable="False" />

                    <Border
                        Width="10"
                        Height="10"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="0,0,1,1"
                        Focusable="False" />

                    <Border
                        Width="10"
                        Height="10"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="0,1,1,0"
                        Focusable="False" />
                </Grid>
                <Grid Visibility="{Binding IsPlaceholder, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <Image
                        Width="84"
                        Height="84"
                        Margin="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        RenderOptions.BitmapScalingMode="Linear"
                        Source="{Binding IconBackground}" />

                    <Image
                        Width="84"
                        Height="84"
                        Margin="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        RenderOptions.BitmapScalingMode="Linear"
                        Source="{Binding Icon}" />

                    <Image
                        Width="84"
                        Height="84"
                        Margin="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        RenderOptions.BitmapScalingMode="Linear"
                        Source="{Binding IconOverlay}" />

                    <RadioButton
                        Width="84"
                        Height="84"
                        charm:StyleHelper.BorderThickness="0.75"
                        Checked="PlugItem_Checked"
                        Focusable="False"
                        GroupName="{Binding Index}"
                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        IsHitTestVisible="True"
                        Style="{StaticResource D2StyleRadioButtonNoSelectedOverlay}" />

                    <Border
                        BorderThickness="3"
                        Focusable="False"
                        Style="{StaticResource GreyBorderWhiteOnHover}">
                        <Grid
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False"
                            Visibility="{Binding ItemWatermark, Converter={StaticResource NullToVisibilityConverter}}">
                            <Rectangle
                                Grid.Row="1"
                                Width="20"
                                Height="43"
                                Opacity="0.6"
                                Stretch="Fill">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                        <GradientStop Offset="0" Color="#00000000" />
                                        <GradientStop Offset="1" Color="Black" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Image
                                Width="18"
                                Height="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                RenderOptions.BitmapScalingMode="Linear"
                                Source="{Binding ItemWatermark}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ConsumableSocket">
            <Grid Margin="5">
                <StackPanel Orientation="Horizontal">
                    <charm:HoverPopupWrapper EnableMotionEffect="False" PopupParent="{x:Type charm:SocketCategory}">
                        <charm:HoverPopupWrapper.Target>
                            <ContentControl Content="{Binding SelectedPlug}" ContentTemplate="{StaticResource ConsumableEntry}" />
                        </charm:HoverPopupWrapper.Target>

                        <charm:HoverPopupWrapper.PopupContent>
                            <!--  negative on the top so it slightly overlays with the target, just for hittest sake  -->
                            <Grid Margin="-50,-10,-60,-10" Background="Transparent">
                                <Grid Margin="15,10,15,10" Background="#BB000000">
                                    <charm:ItemPage
                                        Margin="0,0,0,0"
                                        CollapsePageButtons="False"
                                        Columns="7"
                                        ItemMargin="4"
                                        ItemTemplate="{StaticResource ConsumableEntry}"
                                        Items="{Binding PlugItems}"
                                        ItemsPerPage="21"
                                        SelectOnPageChange="False"
                                        SlideDistance="10"
                                        TransitionSpeed="0.125"
                                        UsePlaceholders="True" />
                                </Grid>
                            </Grid>

                        </charm:HoverPopupWrapper.PopupContent>
                    </charm:HoverPopupWrapper>

                    <TextBlock
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Panel.ZIndex="1"
                        FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                        FontSize="18"
                        Foreground="{StaticResource ForegroundColour100}"
                        Text="{Binding SelectedPlug.Item.Name}" />
                </StackPanel>

            </Grid>
        </DataTemplate>
        <!--  End Consumbable  -->

        <!--  Socket Category  -->
        <DataTemplate x:Key="SocketCategory">
            <Grid Margin="0,0,0,0" HorizontalAlignment="Left">
                <Grid VerticalAlignment="Top">
                    <ItemsControl ItemTemplate="{StaticResource ConsumableSocket}" ItemsSource="{Binding Sockets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel
                                    Grid.Row="0"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </Grid>
        </DataTemplate>
        <!--  End Socket Category  -->

    </UserControl.Resources>

    <Grid Background="Black">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock
            x:Name="OverrideWarning"
            Grid.Column="1"
            Margin="0,10,60,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Panel.ZIndex="100"
            Foreground="Red"
            IsHitTestVisible="False"
            Text="⚠ Mesh contains a skeleton, using Override Vertex Shader.&#x0a;Final result may be inaccurate!"
            TextAlignment="Center"
            Visibility="Hidden" />

        <Canvas x:Name="InfoPanel" Grid.ColumnSpan="2">
            <StackPanel
                shared:Draggable.ClampToParent="True"
                shared:Draggable.Handle="{Binding ElementName=InfoPanelDragHeader}"
                shared:Draggable.InitialLeft="10"
                shared:Draggable.InitialTop="25"
                shared:Draggable.IsEnabled="True"
                Background="#75000000">
                <Border
                    x:Name="InfoPanelDragHeader"
                    BorderBrush="#75000000"
                    BorderThickness="5" />

                <Expander HorizontalAlignment="Stretch" Background="Transparent">
                    <Expander.Header>
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Text="Controls" />
                    </Expander.Header>

                    <Border BorderBrush="#759D9D9D" BorderThickness="0,1,0,0">
                        <StackPanel
                            Margin="5"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            Orientation="Vertical">

                            <ContentControl x:Name="AutoOrbitButton" />
                            <Border
                                Background="#75000000"
                                BorderBrush="#759D9D9D"
                                BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Content.IsChecked, ElementName=AutoOrbitButton}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <ItemsControl x:Name="AutoOrbitOptions">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Margin="5" Orientation="Vertical" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </Border>

                            <ContentControl x:Name="ShowGridButton" />
                            <ContentControl x:Name="ShowAtmosSettings" />

                            <Border
                                Background="#75000000"
                                BorderBrush="#759D9D9D"
                                BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Content.IsChecked, ElementName=ShowAtmosSettings}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel>
                                    <ItemsControl x:Name="AtmosOptions">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Margin="5" Orientation="Vertical" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>

                                    <Grid
                                        Margin="5"
                                        HorizontalAlignment="Stretch"
                                        Background="#75000000">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="25*" />
                                            <ColumnDefinition Width="50*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Margin="24,10,10,10"
                                            VerticalAlignment="Center"
                                            FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                                            FontSize="16"
                                            Text="Scene World"
                                            TextWrapping="Wrap" />

                                        <ComboBox
                                            x:Name="SceneWorldCombobox"
                                            Grid.Column="1"
                                            Margin="5"
                                            BorderBrush="Transparent"
                                            BorderThickness="1"
                                            Focusable="False"
                                            IsReadOnly="False"
                                            SelectionChanged="SceneWorld_OnSelectionChanged"
                                            Style="{DynamicResource D2StyleComboBox}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Grid
                                Margin="0,5,0,5"
                                HorizontalAlignment="Stretch"
                                Background="#75000000">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="25*" />
                                    <ColumnDefinition Width="50*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Margin="24,10,10,10"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                                    FontSize="16"
                                    Text="Render Pass"
                                    TextWrapping="Wrap" />

                                <ComboBox
                                    x:Name="RenderPassCombobox"
                                    Grid.Column="1"
                                    Margin="5"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    Focusable="False"
                                    IsReadOnly="False"
                                    SelectionChanged="Dropdown_OnSelectionChanged"
                                    Style="{DynamicResource D2StyleComboBox}" />
                            </Grid>

                            <!--  Debug Options  -->
                            <Expander
                                Margin="0,0,0,0"
                                HorizontalAlignment="Stretch"
                                Background="#75000000"
                                KeyboardNavigation.DirectionalNavigation="None">
                                <Expander.Header>
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                                        Text="Debug Options" />
                                </Expander.Header>

                                <Border BorderBrush="#759D9D9D" BorderThickness="0,1,0,0">
                                    <StackPanel>
                                        <ItemsControl x:Name="DebugOptions">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Margin="5" Orientation="Vertical" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>

                                        <StackPanel Margin="5" Orientation="Vertical">
                                            <TextBlock
                                                x:Name="CameraPosition"
                                                FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                                                FontSize="14"
                                                Foreground="Cyan" />

                                            <TextBlock
                                                x:Name="CameraRotation"
                                                FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                                                FontSize="14"
                                                Foreground="Cyan" />

                                            <TextBlock
                                                x:Name="FrameTime"
                                                FontFamily="{DynamicResource Haas Grot Text 55 Roman Keys}"
                                                FontSize="14"
                                                Foreground="Cyan" />
                                        </StackPanel>

                                        <Button
                                            Margin="5"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Bottom"
                                            Panel.ZIndex="1"
                                            Click="PrintGlobalChannels_Click"
                                            Focusable="False"
                                            Style="{StaticResource D2StyleButton}"
                                            Visibility="Collapsed">

                                            <TextBlock
                                                Margin="2"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                Text="Print Global Channels" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Expander>

                        </StackPanel>
                    </Border>
                </Expander>
            </StackPanel>
        </Canvas>

        <Canvas x:Name="ObjectPanel" Grid.ColumnSpan="2">
            <StackPanel
                shared:Draggable.ClampToParent="True"
                shared:Draggable.Handle="{Binding ElementName=ObjectPanelDragHeader}"
                shared:Draggable.InitialLeft="175"
                shared:Draggable.InitialTop="25"
                shared:Draggable.IsEnabled="True"
                Background="#75000000">
                <Border
                    x:Name="ObjectPanelDragHeader"
                    BorderBrush="#75000000"
                    BorderThickness="5" />

                <Expander
                    MaxHeight="1000"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    KeyboardNavigation.DirectionalNavigation="None">
                    <Expander.Header>
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Text="Object" />
                    </Expander.Header>

                    <ScrollViewer
                        Margin="0,0,0,0"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Resources>
                            <Style BasedOn="{StaticResource VerticalScrollBarStyle}" TargetType="ScrollBar">
                                <Setter Property="Width" Value="7" />
                            </Style>
                        </ScrollViewer.Resources>
                        <Border BorderBrush="#759D9D9D" BorderThickness="0,1,0,0">
                            <StackPanel Margin="5">
                                <ItemsControl x:Name="ObjectTransforms">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Margin="5" Orientation="Vertical" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <ItemsControl x:Name="ObjectOptions">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Margin="5" Orientation="Vertical" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <Expander
                                    x:Name="MeshGroupsExpander"
                                    MaxHeight="500"
                                    Margin="0,5,0,5"
                                    HorizontalAlignment="Stretch"
                                    Background="#75000000"
                                    Visibility="Collapsed">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Text="Mesh Groups" />

                                            <Button
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Panel.ZIndex="1"
                                                Click="ResetMeshGroups_Click"
                                                Focusable="False"
                                                Style="{StaticResource D2StyleButtonNoOverlay}"
                                                Visibility="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock
                                                    Margin="0"
                                                    VerticalAlignment="Top"
                                                    FontSize="18"
                                                    Foreground="White"
                                                    Text="⟳" />
                                            </Button>
                                        </StackPanel>
                                    </Expander.Header>

                                    <ScrollViewer
                                        Margin="0,0,0,0"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto">
                                        <ScrollViewer.Resources>
                                            <Style BasedOn="{StaticResource VerticalScrollBarStyle}" TargetType="ScrollBar">
                                                <Setter Property="Width" Value="7" />
                                            </Style>
                                        </ScrollViewer.Resources>

                                        <ItemsControl x:Name="MeshGroups" Margin="20,0,20,10">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:ToggleSetting}">
                                                    <StackPanel Margin="3" Orientation="Horizontal">
                                                        <ToggleButton
                                                            IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                            PreviewMouseLeftButtonDown="MeshGroup_PreviewMouseLeftButtonDown"
                                                            Style="{DynamicResource D2StyleToggleBoxButton}">
                                                            <ToggleButton.LayoutTransform>
                                                                <ScaleTransform ScaleX=".75" ScaleY=".75" />
                                                            </ToggleButton.LayoutTransform>
                                                        </ToggleButton>

                                                        <TextBlock
                                                            Margin="0"
                                                            VerticalAlignment="Center"
                                                            FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                                                            FontSize="14"
                                                            Text="{Binding Text}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Expander>

                                <Expander
                                    x:Name="ObjectChannelsExpander"
                                    MaxHeight="500"
                                    Margin="0,5,0,5"
                                    HorizontalAlignment="Stretch"
                                    Background="#75000000"
                                    Visibility="Collapsed">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                                                Text="Object Channels" />

                                            <Button
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Panel.ZIndex="1"
                                                Click="ResetObjectChannels_Click"
                                                Focusable="False"
                                                Style="{StaticResource D2StyleButtonNoOverlay}"
                                                ToolTip="Resets channels to 1, hold Control while clicking to reset to 0"
                                                Visibility="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock
                                                    Margin="0"
                                                    VerticalAlignment="Top"
                                                    FontSize="18"
                                                    Foreground="White"
                                                    Text="⟳" />
                                            </Button>
                                        </StackPanel>
                                    </Expander.Header>

                                    <ScrollViewer
                                        Margin="0,0,0,0"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto">
                                        <ScrollViewer.Resources>
                                            <Style BasedOn="{StaticResource VerticalScrollBarStyle}" TargetType="ScrollBar">
                                                <Setter Property="Width" Value="7" />
                                            </Style>
                                        </ScrollViewer.Resources>
                                        <ItemsControl x:Name="ObjectChannelsEditor" Margin="20,0,20,10">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <UniformGrid
                                                        Margin="0,2,0,2"
                                                        Columns="2"
                                                        Rows="1">
                                                        <TextBlock
                                                            Margin="0,0,10,0"
                                                            Foreground="White"
                                                            Text="{Binding Key, Converter={StaticResource ChannelHashToString}}" />
                                                        <local:Vector4Editor DataContext="{Binding Value}" />
                                                    </UniformGrid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Expander>

                                <Expander
                                    x:Name="MaterialPermutationsExpander"
                                    Margin="0,5,0,5"
                                    HorizontalAlignment="Stretch"
                                    Background="#75000000"
                                    KeyboardNavigation.DirectionalNavigation="None"
                                    Visibility="Collapsed">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Text="Material Permutations" />
                                        </StackPanel>
                                    </Expander.Header>

                                    <StackPanel HorizontalAlignment="Stretch" Orientation="Vertical">
                                        <TextBlock
                                            x:Name="PermIndexDebug"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                                            FontSize="11"
                                            TextWrapping="Wrap" />

                                        <ContentControl x:Name="PermIndexOverride" Margin="5,0,5,0" />

                                        <StackPanel
                                            x:Name="MaterialVariantPanel"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch" />

                                    </StackPanel>
                                </Expander>

                                <Expander
                                    x:Name="InvestmentExpander"
                                    Margin="0,5,0,5"
                                    HorizontalAlignment="Stretch"
                                    Background="#75000000"
                                    Visibility="Collapsed">
                                    <Expander.Header>
                                        <TextBlock
                                            Margin="0,0,0,5"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Panel.ZIndex="1"
                                            FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                                            FontSize="16"
                                            Text="Investment Options" />
                                    </Expander.Header>

                                    <Border BorderBrush="#759D9D9D" BorderThickness="0,1,0,0">
                                        <StackPanel Margin="0,5,0,5">

                                            <StackPanel
                                                x:Name="ArmorGenderToggles"
                                                Margin="0,3,0,3"
                                                Orientation="Vertical"
                                                Visibility="Collapsed">
                                                <RadioButton
                                                    Margin="15,2,0,2"
                                                    Click="ArmorGenderToggle_Click"
                                                    Content="Masculine"
                                                    GroupName="ArmorGender"
                                                    IsChecked="True"
                                                    Tag="0" />
                                                <RadioButton
                                                    Margin="15,2,0,2"
                                                    Click="ArmorGenderToggle_Click"
                                                    Content="Feminine"
                                                    GroupName="ArmorGender"
                                                    Tag="1" />
                                            </StackPanel>

                                            <Expander
                                                x:Name="ItemShadersExpander"
                                                Margin="0,3,0,3"
                                                HorizontalAlignment="Stretch"
                                                Background="Transparent"
                                                Visibility="Collapsed">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            FontFamily="{DynamicResource Haas Grot Text 55 Roman}"
                                                            Text="Item Shaders" />

                                                        <StackPanel
                                                            Margin="15,0,0,0"
                                                            Orientation="Vertical"
                                                            Visibility="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <RadioButton
                                                                Margin="0"
                                                                Click="InvestmentShadersOrderBy_Click "
                                                                Content="Name"
                                                                GroupName="InvestmentShaderSortBy"
                                                                IsChecked="False"
                                                                Tag="0" />
                                                            <RadioButton
                                                                Margin="0"
                                                                Click="InvestmentShadersOrderBy_Click "
                                                                Content="Index"
                                                                GroupName="InvestmentShaderSortBy"
                                                                IsChecked="True"
                                                                Tag="1" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Expander.Header>

                                                <StackPanel Margin="10,0,0,0" Orientation="Vertical">

                                                    <ContentControl x:Name="AllItemShaders" ContentTemplate="{StaticResource SocketCategory}" />

                                                    <ScrollViewer
                                                        x:Name="PerItemShadersPanel"
                                                        MaxHeight="300"
                                                        CanContentScroll="True"
                                                        HorizontalScrollBarVisibility="Disabled"
                                                        VerticalScrollBarVisibility="Auto"
                                                        Visibility="Collapsed">
                                                        <ScrollViewer.Resources>
                                                            <Style BasedOn="{StaticResource VerticalScrollBarStyle}" TargetType="ScrollBar">
                                                                <Setter Property="Width" Value="7" />
                                                            </Style>
                                                        </ScrollViewer.Resources>

                                                        <ItemsControl x:Name="PerItemShaders">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Margin="5,0,5,0" Orientation="Horizontal">
                                                                        <ContentControl
                                                                            Margin="0,0,0,0"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            Content="{Binding Item}"
                                                                            ContentTemplate="{StaticResource ConsumableEntry}" />

                                                                        <Border
                                                                            Width="25"
                                                                            Height="5"
                                                                            Margin="10,5,5,5"
                                                                            HorizontalAlignment="Center"
                                                                            BorderBrush="Gray"
                                                                            BorderThickness="0,2,0,0" />

                                                                        <ContentControl
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            Content="{Binding ShadersCategory}"
                                                                            ContentTemplate="{StaticResource SocketCategory}" />

                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </StackPanel>

                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </Expander>


                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                </Expander>
            </StackPanel>


        </Canvas>

        <Grid
            x:Name="ViewportContainer"
            Grid.ColumnSpan="2"
            Panel.ZIndex="-1">

            <Button
                Width="40"
                Height="40"
                Margin="5"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Panel.ZIndex="1"
                Click="Fullscreen_Click"
                Focusable="False"
                Style="{StaticResource D2StyleButton}">

                <TextBlock
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="25"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="⛶" />

            </Button>

            <Button
                Width="40"
                Height="40"
                Margin="5"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Panel.ZIndex="1"
                Focusable="False"
                Opacity="0.5"
                Style="{StaticResource D2StyleButton}">
                <charm:GenericTooltipProperties.TooltipData>
                    <charm:GenericTooltip
                        Name="CONTROLS"
                        Description="- Use WASD to move the cameras position.&#x0a;- Use Left Mouse to orbit around a fixed point in front of the camera.&#x0a;- Use Middle Mouse to orbit around the active object.&#x0a;- Use Right Mouse to freely look around.&#x0a;- Shift increases movement speed, Left Control slows."
                        Style="Category" />
                </charm:GenericTooltipProperties.TooltipData>

                <TextBlock
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="25"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="?" />

            </Button>

            <Image
                x:Name="RT0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderOptions.BitmapScalingMode="NearestNeighbor"
                RenderOptions.CachingHint="Unspecified"
                RenderOptions.EdgeMode="Unspecified" />

            <TextBlock
                x:Name="FPSCounter"
                Grid.Column="1"
                Margin="15,5,5,5"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#78000000"
                Focusable="False"
                FontFamily="Arial"
                FontSize="14"
                Foreground="White"
                Opacity="0.75"
                TextOptions.TextFormattingMode="Display" />
        </Grid>

    </Grid>
</UserControl>
